{
  "name": "zerra",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "build:css": "postcss src/bundle.css -o dist/bundle.css",
    "build:js": "rollup -c",
    "build": "npm run build:css && npm run build:js",
    "serve": "http-server -c-1 -p 8081",
    "test:release": "node tests/release-regression.cjs",
    "test:ui": "node tests/ui-accessibility-audit.cjs",
    "test:pwa": "node tests/pwa-offline-audit.cjs",
    "test:package": "node tests/package-cleanliness.cjs",
    "test:build": "node tests/build-config-audit.cjs",
    "test:all": "npm run test:release && npm run test:ui && npm run test:pwa && npm run test:package && npm run test:build"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "autoprefixer": "^10.4.19",
    "cssnano": "^7.0.2",
    "http-server": "^14.1.1",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.0",
    "rollup": "^2.79.1",
    "tailwindcss": "^3.4.4",
    "terser": "^5.10.0"
  }
}
